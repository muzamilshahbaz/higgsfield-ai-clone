{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["C:/claude-code/higgsfield-ai-clone/.claude/hooks/capture.js"],
            "timeout": 20,
            "statusMessage": "Capturing session log"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["C:/claude-code/higgsfield-ai-clone/.claude/hooks/capture.js"],
            "timeout": 20,
            "statusMessage": "Capturing prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["C:/claude-code/higgsfield-ai-clone/.claude/hooks/capture.js"],
            "timeout": 20,
            "statusMessage": "Capturing response"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["C:/claude-code/higgsfield-ai-clone/.claude/hooks/capture.js"],
            "timeout": 20,
            "statusMessage": "Finalizing session log"
          }
        ]
      }
    ]
  }
}

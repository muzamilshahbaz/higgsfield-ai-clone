# =====================================================================
# Kinetic Studio — environment
# Copy to .env.local and fill in. .env.local is git-ignored.
# =====================================================================

# --- Supabase (Project Settings -> API) ------------------------------
# Public: safe in the browser. RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses row level security — never prefix with NEXT_PUBLIC_,
# never import into a client component, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

SUPABASE_DB_PASSWORD=your-project-db-password
# --- Site ------------------------------------------------------------
# Used for OAuth redirects, password-reset links and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI provider -----------------------------------------------------
# mock | fal | replicate
# `mock` needs no keys and runs the entire product end to end.
# The app falls back to mock automatically if the selected provider's key
# is missing, so a fresh clone always boots.
AI_PROVIDER=mock

# Only needed when AI_PROVIDER=fal
# FAL_KEY=

# Only needed when AI_PROVIDER=replicate
# REPLICATE_API_TOKEN=

# --- Jobs ------------------------------------------------------------
# Shared secret for /api/cron/sweep. Vercel injects this on Pro plans;
# set any random string locally.
CRON_SECRET=dev-only-change-me

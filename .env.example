# =====================================================================
# Kinetic Studio — environment
# Copy to .env.local and fill in. .env.local is git-ignored.
# =====================================================================

# --- Supabase (Project Settings -> API) ------------------------------
# Public: safe in the browser. RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses row level security — never prefix with NEXT_PUBLIC_,
# never import into a client component, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

SUPABASE_DB_PASSWORD=your-project-db-password
# --- Site ------------------------------------------------------------
# Used for OAuth redirects, password-reset links and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- User provider keys (Settings -> AI model keys) ------------------
# REQUIRED for generation. Seals the API keys users connect, with
# AES-256-GCM. Any high-entropy string; generate one with:
#   openssl rand -base64 48
#
# Treat it like a database password. Changing it does NOT re-encrypt what
# is already stored — every existing key stops opening and users have to
# reconnect. Without it the settings tab renders read-only and nobody can
# connect an account, which means nobody can generate.
# AI_KEY_ENCRYPTION_SECRET=

# --- AI providers ----------------------------------------------------
# Generation runs on whichever of these a user has connected, tried in
# this order: Hugging Face, then fal.ai, then Replicate. See
# docs/PROVIDERS.md for which models each one serves.
#
# Everything below is OPTIONAL and shared: a user's own key from
# Settings -> AI model keys always wins. These cover people who have not
# connected one. With no user key and no shared key, a generation is
# refused with a message naming what to connect — it is never faked.

# huggingface.co/settings/tokens — free account, serves every image model.
# HUGGINGFACE_API_KEY=

# fal.ai/dashboard/keys — the fastest queue, and the one that serves video.
# FAL_KEY=

# replicate.com/account/api-tokens — the broadest catalogue.
# REPLICATE_API_TOKEN=

# --- Jobs ------------------------------------------------------------
# Shared secret for /api/cron/sweep. Vercel injects this on Pro plans;
# set any random string locally.
CRON_SECRET=dev-only-change-me

# --- Vendors that can be verified but not yet generated with ---------
# Each has a key-verification probe in services/ai/providers/ and no
# generation driver, so no model routes to it. Users can still connect
# and verify one; the settings row says "Verify only" so nobody is misled.
# BFL_API_KEY=
# STABILITY_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_AI_API_KEY=
# KLING_API_KEY=accessKey:secretKey
# RUNWAY_API_KEY=
# LUMA_API_KEY=
# PIKA_API_KEY=
